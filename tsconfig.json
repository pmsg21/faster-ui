{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["jest", "@testing-library/jest-dom", "node"]
  },
  "include": ["src", ".storybook/**/*.ts", "jest.setup.ts", "*.config.ts", "*.config.js"],
  // Cypress files live in their own TS project (cypress/tsconfig.json) so the
  // Jest and Cypress global `expect` types never collide in one program.
  "exclude": ["node_modules", "dist", "**/*.cy.tsx"]
}
