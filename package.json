{
  "name": "@pmsg21/faster-ui",
  "version": "0.0.1",
  "description": "Faster — a small, production-ready design system.",
  "type": "module",
  "license": "MIT",
  "author": "Pablo Sierra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmsg21/faster-ui.git"
  },
  "homepage": "https://github.com/pmsg21/faster-ui#readme",
  "bugs": "https://github.com/pmsg21/faster-ui/issues",
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "tailwindcss",
    "components"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.15.0",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "@swc/core",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build && node scripts/emit-styles.mjs && tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p cypress/tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "cypress:open": "cypress open --component",
    "cypress:run": "cypress run --component",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@storybook/addon-a11y": "^8.4.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/addon-interactions": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@storybook/test": "8.6.14",
    "@swc/core": "^1.10.0",
    "@swc/jest": "^0.2.37",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/cypress": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "4.9.1",
    "cypress": "^13.17.0",
    "cypress-axe": "^1.6.0",
    "cypress-real-events": "1.15.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^0.11.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.3.0",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^13.0.3",
    "storybook": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  }
}
